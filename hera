# --- prod update --------------------------------------------------------------
# Upgrades change ONLY the five image digests (plus HERA_VERSION on --pin):
# secrets are never regenerated, so --force is never involved.

check_digest() {
  echo "$2" | grep -qE '^[a-f0-9]{64}$' || die "$1 missing or not a sha256 hex digest ($3)"
}

set_digest() { # FILE KEY DIGEST — replace every occurrence (active or commented), or append
  local file="$1" key="$2" digest="$3" tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX")"
  if grep -qE "^[[:space:]]*#?[[:space:]]*${key}=" "$file"; then
    sed -E "s|^[[:space:]]*#?[[:space:]]*${key}=.*|${key}=${digest}|" "$file" > "$tmp"
  else
    { cat "$file"; printf '\n%s=%s\n' "$key" "$digest"; } > "$tmp"
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

cmd_prod_update() { # --pin vX.Y.Z | --channel stable|beta
  local pin="" channel=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --pin) need_arg "$1" "${2:-}"; pin="$2"; shift 2 ;;
      --channel) need_arg "$1" "${2:-}"; channel="$2"; shift 2 ;;
      -h|--help) usage_prod_update; exit 0 ;;
      *) die "unknown flag for prod update: $1 (see ./hera prod update --help)" ;;
    esac
  done
  [ -z "$pin" ] || valid_release_pin "$pin"
  [ -n "$pin" ] || [ -n "$channel" ] || die "prod update needs --pin vX.Y.Z or --channel stable|beta"
  [ -n "$pin" ] && [ -n "$channel" ] && die "--pin and --channel are exclusive"
  if [ -n "$channel" ] && [ "$channel" != "stable" ] && [ "$channel" != "beta" ]; then
    die "--channel must be stable or beta"
  fi
  EF="$(active_env_file prod)"
  [ -n "$EF" ] || die "no prod env file yet (run ./hera prod up first)"
  local repo="${HERA_REPO:-$PUBLIC_REPO}"
  [ "$repo" = "$PUBLIC_REPO" ] || die "production uses only the public release repository"
  local override
  for override in HERA_API_IMAGE HERA_WEB_IMAGE; do
    [ -z "${!override+x}" ] || validate_hub_image "$override" "${!override}"
  done
  local api_image web_image api_digest="" web_digest="" pg_digest="" rd_digest="" cd_digest=""
  api_image="$(env_value HERA_API_IMAGE "$EF" "$DEFAULT_API_IMAGE")"
  web_image="$(env_value HERA_WEB_IMAGE "$EF" "$DEFAULT_WEB_IMAGE")"

  if [ -n "$pin" ]; then
    need_bin curl "--pin needs curl to fetch the release manifest"
    local url="https://github.com/${repo}/releases/download/${pin}/images.env" manifest
    note "fetching digest manifest $pin …"
    manifest="$(curl -fsSL "$url")" || die "could not fetch $url (does the release exist?)"
    digest_of() { printf '%s\n' "$manifest" | sed -n "s/^$1=sha256://p; s/^$1=//p" | head -n1; }
    api_image="$(digest_of HERA_API_IMAGE)"
    web_image="$(digest_of HERA_WEB_IMAGE)"
    [ -n "$api_image" ] && [ -n "$web_image" ] || die "manifest is missing image repositories"
    api_digest="$(digest_of HERA_API_DIGEST)"
    web_digest="$(digest_of HERA_WEB_DIGEST)"
    pg_digest="$(digest_of HERA_POSTGRES_DIGEST)"
    rd_digest="$(digest_of HERA_REDIS_DIGEST)"
    cd_digest="$(digest_of HERA_CADDY_DIGEST)"
  else
    api_image="$DEFAULT_API_IMAGE"
    web_image="$DEFAULT_WEB_IMAGE"
    need_docker
    pulled_digest() {
      docker pull --quiet "$1" >/dev/null 2>&1 || return 1
      docker image inspect --format '{{index .RepoDigests 0}}' "$1" 2>/dev/null | sed 's/^.*@sha256://'
    }
    note "pulling ${api_image}:api-${channel} (and friends) …"
    api_digest="$(pulled_digest "${api_image}:api-${channel}")" || die "cannot pull ${api_image}:api-${channel} — was a $channel release published? (If the Docker Hub repository is private: docker login docker.io)"
    web_digest="$(pulled_digest "${web_image}:web-${channel}")" || die "cannot pull ${web_image}:web-${channel}"
    pg_digest="$(pulled_digest "$POSTGRES_TAG")" || die "cannot pull $POSTGRES_TAG"
    rd_digest="$(pulled_digest "$REDIS_TAG")" || die "cannot pull $REDIS_TAG"
    cd_digest="$(pulled_digest "$CADDY_TAG")" || die "cannot pull $CADDY_TAG"
  fi
  local pair
  for pair in "HERA_API_DIGEST:${api_digest}" "HERA_WEB_DIGEST:${web_digest}" \
              "HERA_POSTGRES_DIGEST:${pg_digest}" "HERA_REDIS_DIGEST:${rd_digest}" \
              "HERA_CADDY_DIGEST:${cd_digest}"; do
    check_digest "${pair%%:*}" "${pair#*:}" "for ${pin:-$channel}"
  done

  validate_hub_image HERA_API_IMAGE "$api_image"
  validate_hub_image HERA_WEB_IMAGE "$web_image"
  local backup="${EF}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  cp "$EF" "$backup"
  note "backed up $EF → $backup"
  set_digest "$EF" HERA_API_IMAGE "$api_image"
  set_digest "$EF" HERA_WEB_IMAGE "$web_image"
  set_digest "$EF" HERA_API_DIGEST "$api_digest"
  set_digest "$EF" HERA_WEB_DIGEST "$web_digest"
  set_digest "$EF" HERA_POSTGRES_DIGEST "$pg_digest"
  set_digest "$EF" HERA_REDIS_DIGEST "$rd_digest"
  set_digest "$EF" HERA_CADDY_DIGEST "$cd_digest"
  if [ -n "$pin" ]; then
    case "$pin" in
      v*) set_digest "$EF" HERA_VERSION "${pin#v}" ;;
    esac
  fi
  note "pinned ${pin:-$channel}: api ${api_digest:0:12}… web ${web_digest:0:12}… (secrets untouched)"

  need_docker
  compose_for prod
  "${COMPOSE[@]}" pull --quiet || die "could not pull the pinned images"
  set +e
  "${COMPOSE[@]}" up -d --wait
  local status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    up_failed prod
    echo "the previous env file is intact at $backup" >&2
    exit 1
  fi
  note "prod updated to ${pin:-$channel}. Volumes, secrets and the site survived."
}

# --- test ---------------------------------------------------------------------

cmd_test() { # [--e2e] [--lint] [--build] [--keep] [--down] [pytest args...] | down|logs|ps
  shift # drop "test"
  case "${1:-run}" in
    down)
      shift; local volumes=0; ASSUME_YES=0
      while [ $# -gt 0 ]; do
        case "$1" in --volumes|-v) volumes=1; shift ;; --yes) ASSUME_YES=1; shift ;;
          -h|--help) usage_test; exit 0 ;; *) die "unknown flag for test down: $1" ;; esac
      done
      need_docker
      ensure_env_test
      compose_for test
      if [ "$volumes" = "1" ]; then
        confirm "wipe the test project (containers AND volumes)?"
        "${COMPOSE[@]}" down -v --remove-orphans
      else
        "${COMPOSE[@]}" down --remove-orphans
      fi
      return 0 ;;
    logs) shift; cmd_logs test "$@"; return 0 ;;
    ps) shift; cmd_ps test "$@"; return 0 ;;
  esac
  local e2e=0 lint=0 build=0 keep=0 down=0
  local pytest_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --e2e) e2e=1; shift ;;
      --lint) lint=1; shift ;;
      --build) build=1; shift ;;
      --keep) keep=1; shift ;;
      --down) down=1; shift ;;
      -h|--help) usage_test; exit 0 ;;
      --) shift; while [ $# -gt 0 ]; do pytest_args+=("$1"); shift; done ;;
      *) pytest_args+=("$1"); shift ;;
    esac
  done
  need_docker
  ensure_env_test
  compose_for test
  if [ "$down" = "1" ]; then
    trap 'status=$?; "${COMPOSE[@]}" down -v --remove-orphans || status=1; exit "$status"' EXIT
  fi
  if [ "$keep" = "0" ]; then
    note "starting from a clean slate (CI-faithful; pass --keep to reuse the test volume)"
    "${COMPOSE[@]}" down -v --remove-orphans
  fi
  if [ "$build" = "1" ]; then
    note "rebuilding the test image …"
    "${COMPOSE[@]}" build api
  fi
  if [ "$lint" = "1" ]; then
    note "lint + types (same image as runtime) …"
    "${COMPOSE[@]}" run --rm --no-deps api sh -lc "ruff check . && ruff format --check . && mypy app hera_bench"
  fi
  note "pytest in Compose (Postgres + Redis) …"
  if [ "${#pytest_args[@]}" -eq 0 ]; then
    "${COMPOSE[@]}" run --rm api pytest
  else
    "${COMPOSE[@]}" run --rm api pytest "${pytest_args[@]}"
  fi
  if [ "$e2e" = "1" ]; then
    note "bringing the test stack up for Playwright …"
    "${COMPOSE[@]}" down -v --remove-orphans
    "${COMPOSE[@]}" up -d --wait
    "${COMPOSE[@]}" exec -T api hera-bench setup-site --company "Royal Technologies" --currency NGN --admin-email admin@local.test
    "${COMPOSE[@]}" exec -T api hera-bench seed-coa
    "${COMPOSE[@]}" exec -T api hera-bench seed-demo
    note "Playwright login against Compose …"
    "${COMPOSE[@]}" --profile e2e run --rm e2e
  fi
  if [ "$down" = "0" ]; then
    note "test project left running (fast re-runs); tear down with: ./hera test down --volumes"
  fi
}

# --- seed ---------------------------------------------------------------------

cmd_seed() { # ENV [--all|--coa|--demo|--assets|--playground] [--company NAME] [--password PW]
  if [ $# -eq 0 ]; then usage_seed; return 0; fi
  local env="$1"
  shift
  case "$env" in dev|prod|test) ;; -h|--help) usage_seed; exit 0 ;; *) die "unknown environment: $env (want dev, prod or test)" ;; esac
  local want_coa=0 want_demo=0 want_assets=0 want_playground=0 want_all=0
  local company="" password=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) want_all=1; shift ;;
      --coa) want_coa=1; shift ;;
      --demo) want_demo=1; shift ;;
      --assets) want_assets=1; shift ;;
      --playground) want_playground=1; shift ;;
      --company) need_arg "$1" "${2:-}"; company="$2"; shift 2 ;;
      --password) need_arg "$1" "${2:-}"; password="$2"; shift 2 ;;
      -h|--help) usage_seed; exit 0 ;;
      *) die "unknown flag for seed: $1 (see ./hera seed --help)" ;;
    esac
  done
  # Defaults: dev gets the whole playground (it is a superset of coa+demo+
  # assets); prod gets only the starter chart unless asked for more.
  if [ "$want_all$want_coa$want_demo$want_assets$want_playground" = "00000" ]; then
    if [ "$env" = "prod" ]; then want_coa=1; else want_playground=1; fi
  fi
  if [ "$want_all" = "1" ]; then
    if [ "$env" = "prod" ]; then want_coa=1; want_demo=1; want_assets=1
    else want_playground=1; fi
  fi
  # Refused before touching Docker: demo money must never reach real books.
  if [ "$env" = "prod" ] && [ "$want_playground" = "1" ]; then
    die "seed --playground is refused on prod — it posts demo money and publishes a password (use --coa/--demo/--assets)"
  fi
  if [ -n "$password" ] && [ "$want_playground" = "0" ]; then
    die "--password only applies to --playground"
  fi
  need_docker
  EF="$(active_env_file "$env")"
  [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
  compose_for "$env"
  local coa_args=(seed-coa) demo_args=(seed-demo) assets_args=(seed-assets) pg_args=(seed-playground)
  if [ -n "$company" ]; then
    coa_args+=(--company "$company"); demo_args+=(--company "$company")
    assets_args+=(--company "$company"); pg_args+=(--company "$company")
  fi
  [ -n "$password" ] && pg_args+=(--password "$password")
  local failed=0
  run_seed() {
    if ! bench "$env" "$@"; then
      echo "hera: seeding failed — if the site is not bootstrapped yet, finish the /setup wizard" >&2
      echo "  in the browser first, or run: ./hera $env setup --company \"My Company\"" >&2
      failed=1
    fi
    return 0
  }
  [ "$want_coa" = "1" ] && run_seed "${coa_args[@]}"
  [ "$want_demo" = "1" ] && [ "$failed" = "0" ] && run_seed "${demo_args[@]}"
  [ "$want_assets" = "1" ] && [ "$failed" = "0" ] && run_seed "${assets_args[@]}"
  [ "$want_playground" = "1" ] && [ "$failed" = "0" ] && run_seed "${pg_args[@]}"
  [ "$failed" = "1" ] && exit 1
  return 0
}

# --- logs ---------------------------------------------------------------------

cmd_logs() { # ENV [service] [--tail N] [-f|--follow] [--no-follow] [--since X]
  if [ $# -eq 0 ]; then usage_logs; return 0; fi
  local env="$1"
  shift
  case "$env" in dev|prod|test) ;; -h|--help) usage_logs; exit 0 ;; *) die "unknown environment: $env (want dev, prod or test)" ;; esac
  local service="" tail="100" follow=1 since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail) need_arg "$1" "${2:-}"; tail="$2"; shift 2 ;;
      -f|--follow) follow=1; shift ;;
      --no-follow) follow=0; shift ;;
      --since) need_arg "$1" "${2:-}"; since="$2"; shift 2 ;;
      -h|--help) usage_logs; exit 0 ;;
      -*) die "unknown flag for logs: $1 (see ./hera logs --help)" ;;
      *) [ -n "$service" ] && die "logs takes one service (got $service and $1)"
         service="$1"; shift ;;
    esac
  done
  if [ -n "$service" ]; then
    local valid="api worker web proxy db redis migrate backup e2e"
    case " $valid " in *" $service "*) ;; *)
      die "unknown service: $service (want one of: $valid)" ;;
    esac
    if [ "$service" = "backup" ] && [ "$env" != "prod" ]; then
      die "the backup sidecar only exists on prod (dev/test back up through api)"
    fi
    if [ "$service" = "e2e" ] && [ "$env" != "test" ]; then
      die "the e2e runner only exists on test"
    fi
  fi
  need_docker
  EF="$(active_env_file "$env")"
  [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
  compose_for "$env"
  local args=(logs --tail "$tail")
  [ "$follow" = "1" ] && args+=(-f)
  [ -n "$since" ] && args+=(--since "$since")
  [ -n "$service" ] && args+=("$service")
  "${COMPOSE[@]}" "${args[@]}"
}

# --- apps ---------------------------------------------------------------------

cmd_apps() { # ENV list | enable NAME | disable NAME | new NAME [--title T] [--description D]
  if [ $# -eq 0 ]; then usage_apps; return 0; fi
  local env="$1"
  shift
  case "$env" in dev|prod|test) ;; -h|--help) usage_apps; exit 0 ;; *) die "unknown environment: $env (want dev, prod or test)" ;; esac
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) usage_apps; return 0 ;; esac
  done
  local action="${1:-list}"
  case "$action" in
    -h|--help) usage_apps; exit 0 ;;
    list)
      [ $# -le 1 ] || die "apps list takes no arguments"
      need_docker
      EF="$(active_env_file "$env")"
      [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
      compose_for "$env"
      bench "$env" list-apps
      ;;
    enable|disable)
      [ $# -le 2 ] || die "apps $action takes exactly one app name"
      local name="${2:-}"
      [[ "$name" != -* ]] || die "invalid app name: $name"
      [ -n "$name" ] || die "./hera apps $env $action needs an app name (see ./hera apps $env list)"
      need_docker
      EF="$(active_env_file "$env")"
      [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
      compose_for "$env"
      if [ "$action" = "enable" ]; then bench "$env" enable-app "$name"
      else bench "$env" disable-app "$name"; fi
      ;;
    new)
      local name="${2:-}"
      [ -n "$name" ] || die "./hera apps $env new needs a module name"
      shift 2
      [ "$env" = "prod" ] && die "scaffold in dev, not prod: prod has no source mount, so the files would vanish with the container. Run ./hera apps dev new $name, commit, release, then ./hera apps prod enable $name."
      local title="" description=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --title) need_arg "$1" "${2:-}"; title="$2"; shift 2 ;;
          --description) need_arg "$1" "${2:-}"; description="$2"; shift 2 ;;
          *) die "unknown flag for apps new: $1 (see ./hera apps --help)" ;;
        esac
      done
      need_docker
      EF="$(active_env_file "$env")"
      [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
      compose_for "$env"
      local args=(new-module "$name")
      [ -n "$title" ] && args+=(--title "$title")
      [ -n "$description" ] && args+=(--description "$description")
      bench "$env" "${args[@]}"
      note "scaffolded — wire it up, commit it, and enable with: ./hera apps $env enable $name"
      ;;
    *) die "unknown apps action: $action (want list, enable, disable or new)" ;;
  esac
}

# --- backup -------------------------------------------------------------------

backup_service_for() { # ENV — prod has a sidecar; dev/test back up through api
  if [ "$1" = "prod" ]; then printf 'backup'; else printf 'api'; fi
}

cmd_backup() { # ENV [--list] [--restore FILE] [--import FILE] [--yes] [--no-upload] [--retain-days N] [--out DIR]
  if [ $# -eq 0 ]; then usage_backup; return 0; fi
  local env="$1"
  shift
  case "$env" in dev|prod|test) ;; -h|--help) usage_backup; exit 0 ;; *) die "unknown environment: $env (want dev, prod or test)" ;; esac
  local list=0 restore_file="" import_file="" no_upload=0 retain_days="" out=""; ASSUME_YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --list) list=1; shift ;;
      --restore) need_arg "$1" "${2:-}"; restore_file="$2"; shift 2 ;;
      --import) need_arg "$1" "${2:-}"; import_file="$2"; shift 2 ;;
      --yes) ASSUME_YES=1; shift ;;
      --no-upload) no_upload=1; shift ;;
      --retain-days) need_arg "$1" "${2:-}"; retain_days="$2"; shift 2 ;;
      --out) need_arg "$1" "${2:-}"; out="$2"; shift 2 ;;
      -h|--help) usage_backup; exit 0 ;;
      *) die "unknown flag for backup: $1 (see ./hera backup --help)" ;;
    esac
  done
  [ "$list" = "1" ] && [ -n "$restore_file$import_file" ] && die "--list cannot be combined with --restore or --import"
  if [ -n "$retain_days" ]; then
    [[ "$retain_days" =~ ^[1-9][0-9]*$ ]] || die "--retain-days must be a positive integer"
  fi
  need_docker
  EF="$(active_env_file "$env")"
  [ -n "$EF" ] || die "no $env env file yet (run ./hera $env up first)"
  compose_for "$env"
  local svc
  svc="$(backup_service_for "$env")"

  if [ -n "$import_file" ]; then
    [ -r "$import_file" ] || die "import file is not readable: $import_file"
    require_up "$env"
    local imported_name imported_dest
    imported_name="$(basename "$import_file")"
    imported_dest="/backups/$imported_name"
    note "importing $import_file into the $env backup volume as $imported_dest …"
    "${COMPOSE[@]}" cp "$import_file" "api:$imported_dest"
    [ -n "$restore_file" ] || { note "imported — restore with: ./hera backup $env --restore $imported_name"; return 0; }
  fi

  if [ "$list" = "1" ]; then
    require_up "$env"
    "${COMPOSE[@]}" exec -T "$svc" sh -lc 'ls -lh /backups'
    return 0
  fi

  if [ -n "$restore_file" ]; then
    local file="$restore_file"
    case "$file" in /backups/*) ;; *) file="/backups/$(basename "$file")" ;; esac
    "${COMPOSE[@]}" run --rm --no-deps api test -r "$file" || die "backup not readable: $file"
    confirm "restore $file over the $env database? ALL CURRENT $env DATA WILL BE REPLACED."
    local writers="api worker"
    [ "$env" = "prod" ] && writers="api worker backup"
    note "stopping writers ($writers) so nothing writes mid-restore …"
    # Word-splitting writers is deliberate: it is a word list by construction.
    # shellcheck disable=SC2086
    "${COMPOSE[@]}" stop $writers
    note "restoring $file …"
    set +e
    "${COMPOSE[@]}" run --rm --no-deps api hera-bench restore "$file"
    local status=$?
    set -e
    if [ "$status" -ne 0 ]; then
      die "restore failed (exit $status) — writers remain stopped; investigate before running ./hera $env up"
    fi
    note "starting the stack again …"
    "${COMPOSE[@]}" up -d --wait || { up_failed "$env"; die "restore completed but stack startup failed"; }
    note "restored from $file — sign in and verify the data."
    return 0
  fi

  # Immediate backup.
  require_up "$env"
  local args=(backup)
  [ "$no_upload" = "1" ] && args+=(--no-upload)
  [ -n "$retain_days" ] && args+=(--retain-days "$retain_days")
  [ -n "$out" ] && args+=(--out "$out")
  "${COMPOSE[@]}" exec -T "$svc" hera-bench "${args[@]}"
}

# --- env groups ---------------------------------------------------------------

cmd_env() { # dev|prod SUBCOMMAND... — lifecycle for one environment
  local env="$1"; shift
  local sub="${1:-up}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    up) cmd_up "$env" "$@" ;;
    down) cmd_down "$env" "$@" ;;
    restart) cmd_restart "$env" "$@" ;;
    ps) cmd_ps "$env" "$@" ;;
    logs) cmd_logs "$env" "$@" ;;
    shell) cmd_shell "$env" "$@" ;;
    setup) cmd_setup "$env" "$@" ;;
    doctor) cmd_doctor "$env" "$@" ;;
    build) cmd_build "$env" "$@" ;;
    url) cmd_url "$env" "$@" ;;
    update)
      [ "$env" = "prod" ] || die "only prod updates from pinned images (dev rebuilds with ./hera dev build)"
      cmd_prod_update "$@" ;;
    -h|--help|help) usage_env "$env" ;;
    *) die "unknown command: ./hera $env $sub (see ./hera $env --help)" ;;
  esac
}

