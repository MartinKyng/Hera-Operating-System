#!/usr/bin/env bash
# hera — the one Hera command. One command per environment, one file to edit.
#
#   ./hera dev up                  # localhost trial: build, start, open the /setup wizard
#   ./hera prod up --domain ...    # production: pinned images, HTTPS, same wizard
#   ./hera test                    # CI-equivalent tests in Compose (fresh database, like CI)
#   ./hera seed dev                # demo data for dev (full playground site)
#   ./hera seed prod --coa         # starter chart of accounts for prod
#   ./hera logs dev api -f         # follow the API logs on dev
#   ./hera apps dev enable crm     # install + enable an optional app
#   ./hera backup prod             # immediate pg_dump of production
#
# Everything here shells out to Docker Compose and `hera-bench` inside the API
# container — there is still no host install (ADR-005). The per-environment
# config files this manages (deploy/.env.dev, deploy/.env.prod,
# deploy/.env.test) are the things you edit; the CONFIG block below is the
# only behaviour worth editing in this file. Full reference:
# docs/deployment.md
set -euo pipefail

# ===========================================================================
# CONFIG — the editable defaults. Every value can also be overridden with an
# environment variable (e.g. HERA_DEV_ENV_FILE=/srv/hera/dev.env ./hera dev up).
# Relative env-file paths resolve from the repository root, wherever you run
# this script from.
# ===========================================================================
HERA_DEV_ENV_FILE="${HERA_DEV_ENV_FILE:-deploy/.env.dev}"
HERA_PROD_ENV_FILE="${HERA_PROD_ENV_FILE:-deploy/.env.prod}"
HERA_TEST_ENV_FILE="${HERA_TEST_ENV_FILE:-deploy/.env.test}"
HERA_LEGACY_ENV_FILE="${HERA_LEGACY_ENV_FILE:-deploy/.env}"
HERA_DEV_PROJECT="${HERA_DEV_PROJECT:-hera}"
HERA_TEST_PROJECT="${HERA_TEST_PROJECT:-hera-test}"
HERA_PROD_PROJECT="${HERA_PROD_PROJECT:-hera-prod}"
HERA_DEV_PORT="${HERA_DEV_PORT:-8080}"
HERA_TEST_PORT="${HERA_TEST_PORT:-8081}"
# ===========================================================================

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SELF_DIR"
DEPLOY_DIR="$REPO_ROOT/deploy"
ENV_EXAMPLE="$REPO_ROOT/.env.example"
VERSION_FILE="$REPO_ROOT/VERSION"
COMPOSE_BASE="$DEPLOY_DIR/docker-compose.yml"
COMPOSE_DEV_OVERLAY="$DEPLOY_DIR/docker-compose.dev.yml"
COMPOSE_TEST_OVERLAY="$DEPLOY_DIR/docker-compose.test.yml"
COMPOSE_PROD="$DEPLOY_DIR/docker-compose.prod.yml"

PUBLIC_REPO="MartinKyng/Hera-Operating-System"
DEFAULT_API_IMAGE="docker.io/kyngroyalty/hera-os"
DEFAULT_WEB_IMAGE="docker.io/kyngroyalty/hera-os"
POSTGRES_TAG="postgres:16-alpine"
REDIS_TAG="redis:7-alpine"
CADDY_TAG="caddy:2-alpine"

die() { echo "hera: error: $*" >&2; exit 1; }
note() { echo "hera: $*" >&2; }
need_bin() { command -v "$1" >/dev/null 2>&1 || die "$2"; }
need_docker() {
  need_bin docker "docker is required (ADR-005: containers only)"
  docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is required (ADR-005)"
}

abspath() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$REPO_ROOT" "$1" ;;
  esac
}

DEV_ENV_FILE="$(abspath "$HERA_DEV_ENV_FILE")"
PROD_ENV_FILE="$(abspath "$HERA_PROD_ENV_FILE")"
TEST_ENV_FILE="$(abspath "$HERA_TEST_ENV_FILE")"
LEGACY_ENV_FILE="$(abspath "$HERA_LEGACY_ENV_FILE")"

# env_value KEY FILE DEFAULT — the value KEY has in an env file (last wins).
env_value() {
  local value=""
  [ -f "$2" ] && value="$(sed -n "s|^[[:space:]]*$1=\([^[:space:]#]*\).*|\1|p" "$2" | tail -n 1)"
  printf '%s' "${value:-$3}"
}

hex() { openssl rand -hex "$1"; }

manifest_value() { # MANIFEST KEY — first KEY= value, accepting optional sha256:
  printf '%s\n' "$1" | sed -n "s/^$2=sha256://p; s/^$2=//p" | head -n1
}

pull_digest() { # IMAGE:TAG — pull and return the RepoDigest sha256 hex
  docker pull --quiet "$1" >/dev/null 2>&1 || return 1
  docker image inspect --format '{{index .RepoDigests 0}}' "$1" 2>/dev/null | sed 's/^.*@sha256://'
}

generate_env_file() { # dev|prod TARGET DOMAIN PIN CHANNEL ACME HTTP HTTPS ADMIN_EMAIL
  local env="$1" target="$2" domain="${3:-}" pin="${4:-}" channel="${5:-}" acme="${6:-}" http="${7:-}" https="${8:-}" admin="${9:-}"
  local api_image="$DEFAULT_API_IMAGE" web_image="$DEFAULT_WEB_IMAGE"
  local api_digest="" web_digest="" pg_digest="" rd_digest="" cd_digest=""
  local version_value="" tmp key pair manifest url

  [ -f "$ENV_EXAMPLE" ] || die "template not found: $ENV_EXAMPLE"
  [ ! -e "$target" ] || die "$target already exists — secrets are generated once; re-run ./hera $env up to keep them, or edit deliberately"
  [ -n "$admin" ] || admin="admin@local.test"

  if [ "$env" = prod ]; then
    [ "${HERA_REPO:-$PUBLIC_REPO}" = "$PUBLIC_REPO" ] || die "production uses only the public release repository $PUBLIC_REPO"
    [ -n "$domain" ] || die "the first prod boot needs --domain (e.g. ./hera prod up --domain books.example.com)"
    for key in HERA_API_IMAGE HERA_WEB_IMAGE; do
      [ -z "${!key+x}" ] || validate_hub_image "$key" "${!key}"
    done
    if [ -z "$pin" ] && [ -z "$channel" ]; then
      channel="stable"
      note "no --pin/--channel given — pinning the rolling 'stable' tag (pass --pin vX.Y.Z for an exact release)"
    fi
    if [ -n "$pin" ]; then
      need_bin curl "--pin needs curl to fetch the release manifest"
      url="https://github.com/${PUBLIC_REPO}/releases/download/${pin}/images.env"
      note "fetching digest manifest $pin …"
      manifest="$(curl -fsSL "$url")" || die "could not fetch $url (does the release exist?)"
      api_image="$(manifest_value "$manifest" HERA_API_IMAGE)"
      web_image="$(manifest_value "$manifest" HERA_WEB_IMAGE)"
      [ -n "$api_image" ] && [ -n "$web_image" ] || die "manifest is missing image repositories"
      validate_hub_image HERA_API_IMAGE "$api_image"
      validate_hub_image HERA_WEB_IMAGE "$web_image"
      api_digest="$(manifest_value "$manifest" HERA_API_DIGEST)"
      web_digest="$(manifest_value "$manifest" HERA_WEB_DIGEST)"
      pg_digest="$(manifest_value "$manifest" HERA_POSTGRES_DIGEST)"
      rd_digest="$(manifest_value "$manifest" HERA_REDIS_DIGEST)"
      cd_digest="$(manifest_value "$manifest" HERA_CADDY_DIGEST)"
    else
      need_bin docker "--channel pulls images, which needs docker (use --pin to read a release manifest)"
      note "pulling ${api_image}:api-${channel} (and friends) to pin immutable digests …"
      api_digest="$(pull_digest "${api_image}:api-${channel}")" || die "cannot pull ${api_image}:api-${channel} — was a $channel release published? (If Docker Hub is private: docker login docker.io)"
      web_digest="$(pull_digest "${web_image}:web-${channel}")" || die "cannot pull ${web_image}:web-${channel}"
      pg_digest="$(pull_digest "$POSTGRES_TAG")" || die "cannot pull $POSTGRES_TAG"
      rd_digest="$(pull_digest "$REDIS_TAG")" || die "cannot pull $REDIS_TAG"
      cd_digest="$(pull_digest "$CADDY_TAG")" || die "cannot pull $CADDY_TAG"
    fi
    for pair in "HERA_API_DIGEST:${api_digest}" "HERA_WEB_DIGEST:${web_digest}" \
                "HERA_POSTGRES_DIGEST:${pg_digest}" "HERA_REDIS_DIGEST:${rd_digest}" \
                "HERA_CADDY_DIGEST:${cd_digest}"; do
      check_digest "${pair%%:*}" "${pair#*:}" "for ${pin:-$channel}"
    done
    note "pinned ${pin:-$channel}: api ${api_digest:0:12}… web ${web_digest:0:12}…"
  fi

  if [ -f "$VERSION_FILE" ]; then
    version_value="$(tr -d '[:space:]' < "$VERSION_FILE")"
  else
    note "WARNING: no VERSION file at $VERSION_FILE — images will be labelled 'dev'"
  fi

  note "generating secrets …"
  local hera_secret postgres_password db_app_password db_migrate_password db_backup_password redis_password admin_password
  hera_secret="$(hex 32)"
  postgres_password="$(hex 16)"
  db_app_password="$(hex 16)"
  db_migrate_password="$(hex 16)"
  db_backup_password="$(hex 16)"
  redis_password="$(hex 16)"
  admin_password="$(hex 12)"

  local -a managed=(
    HERA_ENV HERA_DOMAIN HERA_SECRET_KEY HERA_VERSION
    HERA_ADMIN_EMAIL HERA_ADMIN_PASSWORD HERA_HTTP_PORT HERA_HTTPS_PORT ACME_EMAIL
    HERA_CORS_ORIGINS HERA_TRUSTED_HOSTS HERA_PUBLIC_BASE_URL
    POSTGRES_PASSWORD HERA_DB_APP_PASSWORD HERA_DB_MIGRATE_PASSWORD HERA_DB_BACKUP_PASSWORD
    REDIS_PASSWORD REDIS_URL
    HERA_API_IMAGE HERA_WEB_IMAGE
    HERA_API_DIGEST HERA_WEB_DIGEST HERA_POSTGRES_DIGEST HERA_REDIS_DIGEST HERA_CADDY_DIGEST
  )
  local -a delete_exprs=()
  for key in "${managed[@]}"; do delete_exprs+=(-e "/^#?[[:space:]]*${key}=/d"); done

  mkdir -p "$(dirname "$target")"
  tmp="$(mktemp "${target}.tmp.XXXXXX")"
  trap 'rm -f "${tmp:-}"' RETURN
  sed -E "${delete_exprs[@]}" "$ENV_EXAMPLE" > "$tmp"

  cat >> "$tmp" <<EOF

# ---------------------------------------------------------------------------
# Managed by ./hera ($(date -u +%Y-%m-%dT%H:%M:%SZ)) — generated secrets,
# digest-pinned production images, derived allowlists. Do not duplicate these keys above.
# ---------------------------------------------------------------------------

# --- Core
HERA_ENV=${env}
HERA_VERSION=${version_value}
HERA_DOMAIN=${domain:-localhost}
HERA_SECRET_KEY=${hera_secret}
# Used only by the scripted bootstrap (hera-bench setup-site, CI). The /setup
# wizard asks for the Administrator in the browser and ignores these.
HERA_ADMIN_EMAIL=${admin}
HERA_ADMIN_PASSWORD=${admin_password}
EOF

  if [ "$env" = prod ]; then
    cat >> "$tmp" <<EOF
HERA_HTTP_PORT=${http:-80}
HERA_HTTPS_PORT=${https:-443}
ACME_EMAIL=${acme:-ops@${domain}}
HERA_PUBLIC_BASE_URL=https://${domain}
HERA_CORS_ORIGINS=https://${domain}
HERA_TRUSTED_HOSTS=${domain},127.0.0.1,hera-api
EOF
  else
    echo "HERA_HTTP_PORT=${http:-8080}" >> "$tmp"
  fi

  cat >> "$tmp" <<EOF

# --- Postgres (three least-privilege roles; see deploy/postgres/init-roles.sh)
POSTGRES_PASSWORD=${postgres_password}
HERA_DB_APP_PASSWORD=${db_app_password}
HERA_DB_MIGRATE_PASSWORD=${db_migrate_password}
HERA_DB_BACKUP_PASSWORD=${db_backup_password}

# --- Redis
REDIS_PASSWORD=${redis_password}
REDIS_URL=redis://:${redis_password}@hera-redis:6379/0

# --- Images (Docker Hub only; prod digests pinned by ${pin:+--pin ${pin}}${channel:+--channel ${channel}}${pin:-${channel:-<none>}})
HERA_API_IMAGE=${api_image}
HERA_WEB_IMAGE=${web_image}
HERA_API_DIGEST=${api_digest}
HERA_WEB_DIGEST=${web_digest}
HERA_POSTGRES_DIGEST=${pg_digest}
HERA_REDIS_DIGEST=${rd_digest}
HERA_CADDY_DIGEST=${cd_digest}
EOF

  chmod 600 "$tmp"
  mv "$tmp" "$target"
  trap - RETURN
  note "wrote $target (mode: $env, images: $api_image, pin: ${pin:-${channel:-none}})"
}

need_arg() { # FLAG VALUE — every --flag value goes through here
  [ -n "${2:-}" ] && [[ "$2" != -* ]] || die "$1 needs a value (see the --help for this command)"
}

valid_port() {
  [[ "$2" =~ ^[0-9]{1,5}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 65535 )) || die "$1 must be a port from 1 to 65535"
}

confirm() { # PROMPT — honour --yes, refuse without a terminal, else ask.
  if [ "${ASSUME_YES:-0}" = "1" ]; then return 0; fi
  if [ ! -t 0 ]; then die "$1 (pass --yes to confirm without a terminal)"; fi
  local answer=""
  read -r -p "hera: $1 [y/N] " answer
  [ "$answer" = "y" ] || [ "$answer" = "Y" ] || die "aborted."
}

# --- environment files ------------------------------------------------------
# Each environment owns one editable file. A legacy deploy/.env is honoured
# when the per-environment file does not exist yet, so existing checkouts keep
# working with a visible note.

target_env_file() { # dev|prod|test -> the file that environment owns
  case "$1" in
    dev) printf '%s' "$DEV_ENV_FILE" ;;
    prod) printf '%s' "$PROD_ENV_FILE" ;;
    test) printf '%s' "$TEST_ENV_FILE" ;;
    *) die "unknown environment: $1 (want dev, prod or test)" ;;
  esac
}

active_env_file() { # dev|prod|test -> the file in force ("" when none exists)
  local owned
  owned="$(target_env_file "$1")"
  if [ -f "$owned" ]; then printf '%s' "$owned"; return 0; fi
  if [ "$1" != "test" ] && [ -f "$LEGACY_ENV_FILE" ]; then
    note "no $owned yet — using legacy $LEGACY_ENV_FILE (copy it to $owned to silence this)"
    printf '%s' "$LEGACY_ENV_FILE"; return 0
  fi
  printf ''
}

EF="" # the env file in force for the current command (set by ensure_env_*)

ensure_env_dev() { # [http-port] — generate .env.dev on first boot only
  local port="${1:-$HERA_DEV_PORT}"
  EF="$(active_env_file dev)"
  [ -n "$EF" ] && return 0
  need_bin openssl "openssl is required to generate secrets"
  note "first boot: generating $DEV_ENV_FILE"
  generate_env_file dev "$DEV_ENV_FILE" "" "" "" "" "$port" "" "${ADMIN_EMAIL:-}"
  EF="$DEV_ENV_FILE"
}

ensure_env_prod() { # requires PROD_* globals when the file does not exist yet
  EF="$(active_env_file prod)"
  if [ -n "$EF" ]; then
    [ -z "${PROD_DOMAIN:-}" ] || note "$EF exists — --domain does not change saved domain/URL/allowlists"
    if [ -n "${PROD_PIN:-}${PROD_CHANNEL:-}" ]; then
      note "$EF exists — ignoring --pin/--channel (change digests with: ./hera prod update)"
    fi
    return 0
  fi
  [ -n "${PROD_DOMAIN:-}" ] || die "the first prod boot needs --domain (e.g. ./hera prod up --domain books.example.com)"
  need_bin openssl "openssl is required to generate secrets"
  note "first boot: generating $PROD_ENV_FILE"
  generate_env_file prod "$PROD_ENV_FILE" "$PROD_DOMAIN" "${PROD_PIN:-}" "${PROD_CHANNEL:-}" \
    "${PROD_ACME_EMAIL:-}" "${PROD_HTTP_PORT:-}" "${PROD_HTTPS_PORT:-}" "${ADMIN_EMAIL:-}"
  EF="$PROD_ENV_FILE"
}

ensure_env_test() { # test-only values, never real secrets (mirrors ci.yml)
  EF="$(active_env_file test)"
  [ -n "$EF" ] && return 0
  [ -f "$ENV_EXAMPLE" ] || die "template not found: $ENV_EXAMPLE"
  note "first run: generating $TEST_ENV_FILE (test-only values, never real secrets)"
  local tmp
  mkdir -p "$(dirname "$TEST_ENV_FILE")"
  tmp="$(mktemp "${TEST_ENV_FILE}.tmp.XXXXXX")"
  sed -E \
    -e 's/^HERA_SECRET_KEY=.*/HERA_SECRET_KEY=test-only-not-a-secret-0123456789abcdef/' \
    -e 's/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=test-postgres/' \
    -e 's/^HERA_DB_APP_PASSWORD=.*/HERA_DB_APP_PASSWORD=test-app/' \
    -e 's/^HERA_DB_MIGRATE_PASSWORD=.*/HERA_DB_MIGRATE_PASSWORD=test-migrate/' \
    -e 's/^HERA_DB_BACKUP_PASSWORD=.*/HERA_DB_BACKUP_PASSWORD=test-backup/' \
    -e 's/^REDIS_PASSWORD=.*/REDIS_PASSWORD=test-redis/' \
    -e 's#^REDIS_URL=.*#REDIS_URL=redis://:test-redis@hera-redis:6379/0#' \
    -e 's/^HERA_ADMIN_EMAIL=.*/HERA_ADMIN_EMAIL=admin@local.test/' \
    -e 's/^HERA_ADMIN_PASSWORD=.*/HERA_ADMIN_PASSWORD=AdminPass1234/' \
    -e 's/^#HERA_PAYMENTS_STUB=0/HERA_PAYMENTS_STUB=1/' \
    -e "s/^HERA_HTTP_PORT=.*/HERA_HTTP_PORT=$HERA_TEST_PORT/" \
    "$ENV_EXAMPLE" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$TEST_ENV_FILE"
  EF="$TEST_ENV_FILE"
}

# --- compose ----------------------------------------------------------------
# COMPOSE is a global array so paths with spaces survive: "${COMPOSE[@]}" ...

COMPOSE=()

compose_dev() {
  COMPOSE=(docker compose --env-file "$EF" -f "$COMPOSE_BASE")
  if [ "${HMR:-0}" = "1" ]; then COMPOSE+=(-f "$COMPOSE_DEV_OVERLAY"); fi
  COMPOSE+=(-p "$HERA_DEV_PROJECT")
}

compose_test() {
  [ "$HERA_TEST_PROJECT" != "$HERA_DEV_PROJECT" ] && [ "$HERA_TEST_PROJECT" != "$HERA_PROD_PROJECT" ] || die "test project must differ from dev and prod (tests delete volumes)"
  [ "$(env_value HERA_ENV "$EF" dev)" != "prod" ] || die "test refuses a production env file"

  COMPOSE=(docker compose --env-file "$EF" -f "$COMPOSE_BASE" -f "$COMPOSE_TEST_OVERLAY" -p "$HERA_TEST_PROJECT")
}

compose_prod() {
  validate_prod_images
  COMPOSE=(docker compose --env-file "$EF" -f "$COMPOSE_PROD" -p "$HERA_PROD_PROJECT")
}

compose_for() { # dev|prod|test — build COMPOSE for an environment
  case "$1" in
    dev) compose_dev ;;
    test) compose_test ;;
    prod) compose_prod ;;
    *) die "unknown environment: $1 (want dev, prod or test)" ;;
  esac
}

require_up() { # ENV — the api container must exist and run
  if ! "${COMPOSE[@]}" exec -T api true >/dev/null 2>&1; then
    die "the $1 stack is not running — start it first: ./hera $1 up"
  fi
}

bench() { # ENV hera-bench args... — run hera-bench inside the API container
  local env="$1"; shift
  require_up "$env"
  "${COMPOSE[@]}" exec -T api hera-bench "$@"
}

# --- first-boot guards ------------------------------------------------------

tcp_port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1; }

preflight_port() { # PORT ENV — refuse before pulling when someone holds the port
  local port="$1" env="$2" holders mine id rest foreign=""
  tcp_port_busy "$port" || return 0
  mine="$("${COMPOSE[@]}" ps -aq 2>/dev/null | tr '\n' ' ' || true)"
  holders="$(docker ps --no-trunc --filter "publish=$port" --format '{{.ID}}|{{.Names}}|{{.Ports}}' 2>/dev/null || true)"
  if [ -n "$holders" ]; then
    while IFS='|' read -r id rest; do
      [ -n "${id:-}" ] || continue
      case " $mine " in *" $id "*) continue ;; esac
      foreign="${foreign}    ${rest}"$'\n'
    done <<< "$holders"
    if [ -z "$foreign" ]; then
      note "host port $port is published by this stack's own proxy — it will be recreated"
      return 0
    fi
  fi
  echo "" >&2
  echo "hera: error: host port $port is already in use — the proxy (Caddy) cannot bind it." >&2
  if [ -n "$foreign" ]; then
    echo "  Another container is publishing it:" >&2
    printf '%s' "$foreign" >&2
  else
    echo "  A host process (not a container) is listening on it." >&2
  fi
  echo "  Stop that listener and re-run, or move Hera onto a free port:" >&2
  if [ "$env" = "prod" ]; then
    echo "    ./hera prod up --http-port <free> --https-port <free>" >&2
  else
    echo "    ./hera $env up --port <free>" >&2
  fi
  echo "  Nothing was started and no volume was touched — this is a host port" >&2
  echo "  conflict, not a database problem." >&2
  exit 1
}

container_detail() { # NAME — status|exit|error|health
  docker inspect --format \
    '{{.State.Status}}|{{.State.ExitCode}}|{{.State.Error}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
    "$1" 2>/dev/null || true
}

up_failed() { # ENV — compact post-mortem: states, cause, then service logs
  local env="$1" service name state detail status exit_code error health line log_out
  local states cause="unknown" culprit="" blob="" migrate_exit=""
  local -a failed=()

  states="$("${COMPOSE[@]}" ps -a --format '{{.Service}}|{{.Name}}|{{.State}}' 2>/dev/null || true)"
  echo "" >&2
  echo "hera: the $env stack did not come up healthy." >&2
  echo "" >&2
  echo "service states:" >&2
  if [ -n "$states" ]; then
    while IFS='|' read -r service name state; do
      [ -n "${service:-}" ] || continue
      detail="$(container_detail "$name")"
      status="${state:-unknown}"; exit_code=""; error=""; health="none"
      if [ -n "$detail" ]; then
        status="${detail%%|*}"; detail="${detail#*|}"
        exit_code="${detail%%|*}"; detail="${detail#*|}"
        error="${detail%|*}"; health="${detail##*|}"
        blob="${blob} ${error}"
        [ "$service" = migrate ] && migrate_exit="$exit_code"
      fi
      case "$status" in
        running)
          case "$health" in
            healthy) line="running (healthy)" ;;
            starting) line="running (healthcheck still starting)" ;;
            none) line="running" ;;
            *) line="RUNNING BUT UNHEALTHY"; failed+=("$service") ;;
          esac ;;
        exited)
          if [ "$exit_code" = "0" ]; then line="exited 0 (one-shot: success)"
          else line="EXITED ${exit_code:-?}"; failed+=("$service"); fi ;;
        created) line="created — never started"; failed+=("$service") ;;
        *) line="$status"; failed+=("$service") ;;
      esac
      printf '  %-10s %s\n' "$service" "$line" >&2
      [ -n "$error" ] && printf '  %-10s   %s\n' "" "$error" >&2
    done <<< "$states"
  else
    echo "  (no containers were reported — the failure happened before any started)" >&2
    "${COMPOSE[@]}" ps -a >&2 || true
  fi

  culprit="$(printf '%s\n' "$blob" | sed -n \
    -e 's/.*failed to bind host port [0-9.]*:\([0-9][0-9]*\)\/.*/\1/p' \
    -e 's/.*listen tcp[46]*[[:space:]]\[*[0-9a-fA-F:.]*\]*:\([0-9][0-9]*\): bind: address already in use.*/\1/p' \
    | head -n 1)"
  if printf '%s' "$blob" | grep -qi 'address already in use'; then
    cause="port"
  elif [ -n "$migrate_exit" ] && [ "$migrate_exit" != "0" ]; then
    cause="migrate"
  elif [ "${#failed[@]}" -gt 0 ]; then
    cause="crash"
  elif printf '%s' "$blob" | grep -qiE 'unhealthy|dependency failed to start'; then
    cause="unhealthy"
  fi

  echo "" >&2
  case "$cause" in
    port) echo "cause: host port ${culprit:-?} is already in use — the proxy cannot bind it" >&2 ;;
    migrate) echo "cause: the one-shot migrate service failed; api and worker wait on it" >&2 ;;
    crash) echo "cause: ${failed[*]:-a service} exited or never started" >&2 ;;
    unhealthy) echo "cause: a container started but never passed its healthcheck in time" >&2 ;;
    *) echo "cause: not one of the known first-boot causes — the logs below are the evidence" >&2 ;;
  esac

  echo "" >&2
  echo "last logs:" >&2
  for service in web migrate api worker db redis proxy backup; do
    echo "---------------- $service ----------------" >&2
    log_out="$("${COMPOSE[@]}" logs --tail 60 "$service" 2>/dev/null || true)"
    if [ -n "$log_out" ]; then printf '%s\n' "$log_out" >&2; else echo "(no output)" >&2; fi
  done

  echo "" >&2
  echo "hints:" >&2
  case "$cause" in
    port)
      echo "  - this is a host port conflict, not a schema or data problem; do NOT wipe volumes for it." >&2
      echo "  - stop the listener, or move Hera onto free ports:" >&2
      if [ "$env" = prod ]; then
        echo "      ./hera prod up --http-port <free> --https-port <free>" >&2
        echo "    Caddy automatic HTTPS expects public 80/443 unless you put your own TLS proxy in front." >&2
      else
        echo "      ./hera $env up --port <free>" >&2
      fi ;;
    migrate)
      echo "  - read the migrate log above. Only a never-used site may be wiped:" >&2
      echo "      ./hera $env down --volumes" >&2
      echo "    A site WITH data must be fixed or restored, never wiped." >&2 ;;
    crash|unhealthy|unknown)
      echo "  - read the service log above for the service named in the cause." >&2
      echo "  - after dependency changes in dev, rebuild with: ./hera dev build api worker" >&2
      echo "  - never delete database volumes to repair frontend dependencies." >&2 ;;
  esac
  echo "  - full state: ./hera $env ps -a" >&2
  echo "  - follow one service: ./hera logs $env <service>" >&2
  echo "  - reference: docs/deployment.md (troubleshooting)." >&2
}

site_url_for() { # ENV — the desk URL, read back from the env file in force
  local env="$1" domain http https def
  if [ "$env" = "prod" ]; then
    domain="$(env_value HERA_DOMAIN "$EF" "")"
    http="${one_shot_port:-$(env_value HERA_HTTP_PORT "$EF" 80)}"
    https="${one_shot_https:-$(env_value HERA_HTTPS_PORT "$EF" 443)}"
    if [ "$http" = "80" ] && [ "$https" = "443" ]; then
      printf 'https://%s' "$domain"
    else
      printf 'http://%s:%s (custom ports: put your own TLS proxy in front, or use DNS-01)' "$domain" "$http"
    fi
  else
    def="$HERA_DEV_PORT"
    [ "$env" = "test" ] && def="$HERA_TEST_PORT"
    http="${one_shot_port:-$(env_value HERA_HTTP_PORT "$EF" "$def")}"
    printf 'http://localhost:%s' "$http"
  fi
}

print_next_steps() { # ENV — wizard URL, setup status, seed hint
  local env="$1" url status=""
  url="$(site_url_for "$env")"
  echo ""
  echo "Hera ($env) is up. Open the desk to finish setup:"
  echo "  -> $url"
  echo "     A fresh site opens the /setup wizard: create the Administrator, name the"
  echo "     company, pick currency + timezone — then sign in."
  if command -v curl >/dev/null 2>&1; then
    status="$(curl -fsS "$url/api/v1/setup/status" 2>/dev/null || true)"
    [ -n "$status" ] && echo "  -> setup status: $status"
  fi
  echo ""
  if [ "$env" = "prod" ]; then
    echo "seed data (after the wizard):  ./hera seed prod --coa"
  else
    echo "seed data (after the wizard):  ./hera seed $env   (full playground site)"
  fi
  echo "follow the logs:             ./hera logs $env"
}

# --- dev / prod lifecycle ---------------------------------------------------

cmd_up() { # ENV [flags] — generate env on first boot, preflight, pull, up
  local env="$1"; shift
  local build=0 fresh=0 no_wait=0 no_pull=0 hmr=0 one_shot_port="" one_shot_https=""
  HMR=0; ASSUME_YES=0; ADMIN_EMAIL=""
  PROD_DOMAIN=""; PROD_PIN=""; PROD_CHANNEL=""; PROD_ACME_EMAIL=""
  PROD_HTTP_PORT=""; PROD_HTTPS_PORT=""
  local dev_port=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --build) build=1; shift ;;
      --fresh) fresh=1; shift ;;
      --hmr) hmr=1; shift ;;
      --no-wait) no_wait=1; shift ;;
      --no-pull) no_pull=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --port) need_arg "$1" "${2:-}"; dev_port="$2"; shift 2 ;;
      --domain) need_arg "$1" "${2:-}"; PROD_DOMAIN="$2"; shift 2 ;;
      --pin) need_arg "$1" "${2:-}"; PROD_PIN="$2"; shift 2 ;;
      --channel) need_arg "$1" "${2:-}"; PROD_CHANNEL="$2"; shift 2 ;;
      --acme-email) need_arg "$1" "${2:-}"; PROD_ACME_EMAIL="$2"; shift 2 ;;
      --http-port) need_arg "$1" "${2:-}"; PROD_HTTP_PORT="$2"; [ "$env" = "dev" ] && dev_port="$PROD_HTTP_PORT"; shift 2 ;;
      --https-port) need_arg "$1" "${2:-}"; PROD_HTTPS_PORT="$2"; shift 2 ;;
      --admin-email) need_arg "$1" "${2:-}"; ADMIN_EMAIL="$2"; shift 2 ;;
      -h|--help) usage_up "$env"; exit 0 ;;
      *) die "unknown flag for $env up: $1 (see ./hera $env up --help)" ;;
    esac
  done
  [ "$env" = "prod" ] && [ "$hmr" = "1" ] && die "--hmr is a dev flag (prod serves the built desk)"
  [ "$env" = "prod" ] && [ "$build" = "1" ] && die "prod uses pinned images, never local builds (upgrade with ./hera prod update)"
  [ -z "$PROD_PIN" ] || valid_release_pin "$PROD_PIN"
  [ -n "$PROD_PIN" ] && [ -n "$PROD_CHANNEL" ] && die "--pin and --channel are exclusive: a release manifest OR a rolling tag"
  if [ -n "$PROD_CHANNEL" ] && [ "$PROD_CHANNEL" != "stable" ] && [ "$PROD_CHANNEL" != "beta" ]; then
    die "--channel must be stable or beta"
  fi
  [ -z "$dev_port" ] || valid_port --port "$dev_port"
  [ -z "$PROD_HTTP_PORT" ] || valid_port --http-port "$PROD_HTTP_PORT"
  [ -z "$PROD_HTTPS_PORT" ] || valid_port --https-port "$PROD_HTTPS_PORT"
  if [ "$env" = "dev" ] && [ -n "$PROD_DOMAIN$PROD_PIN$PROD_CHANNEL$PROD_ACME_EMAIL$PROD_HTTPS_PORT" ]; then
    die "--domain, --pin, --channel, --acme-email and --https-port are prod flags"
  fi
  [ "$env" != "prod" ] || [ -z "$dev_port" ] || die "--port is a dev flag; use --http-port on prod"
  need_docker
  HMR="$hmr"

  # First boot generates the env file (persisting the ports); later boots
  # keep it, and --port/--http-port/--https-port apply one-shot.
  local existed=1
  if [ -z "$(active_env_file "$env" 2>/dev/null)" ]; then existed=0; fi
  if [ "$env" = "prod" ]; then
    ensure_env_prod
  else
    ensure_env_dev "$dev_port"
  fi
  if [ "$existed" = "1" ]; then
    local req_http="$dev_port"
    [ -n "$PROD_HTTP_PORT" ] && req_http="$PROD_HTTP_PORT"
    if [ -n "$req_http" ]; then
      one_shot_port="$req_http"
      note "one-shot port $one_shot_port (not saved; persist it as HERA_HTTP_PORT in $EF)"
    fi
    if [ -n "$PROD_HTTPS_PORT" ]; then
      one_shot_https="$PROD_HTTPS_PORT"
      note "one-shot https port $one_shot_https (not saved; persist it as HERA_HTTPS_PORT in $EF)"
    fi
  fi
  [ "$env" != prod ] || validate_prod_images
  compose_for "$env"

  if [ "$fresh" = "1" ]; then
    confirm "wipe the $env site (containers AND volumes — all data deleted)?"
    "${COMPOSE[@]}" down -v --remove-orphans
  fi
  if [ "$build" = "1" ]; then
    note "rebuilding images …"
    "${COMPOSE[@]}" build
  fi

  local up_args=(up -d)
  [ "$no_wait" = "0" ] && up_args+=(--wait)

  if [ "$env" = "prod" ]; then
    preflight_port "${one_shot_port:-$(env_value HERA_HTTP_PORT "$EF" 80)}" prod
    preflight_port "${one_shot_https:-$(env_value HERA_HTTPS_PORT "$EF" 443)}" prod
    if [ "$no_pull" = "0" ]; then
      note "pulling pinned images …"
      "${COMPOSE[@]}" pull --quiet || die "could not pull the pinned images (docker login docker.io, or re-pin a release that exists — see ./hera prod update --help)"
    fi
  else
    if [ -n "$one_shot_port" ]; then preflight_port "$one_shot_port" "$env";
    else preflight_port "$(env_value HERA_HTTP_PORT "$EF" "$HERA_DEV_PORT")" "$env"; fi
    note "starting the $env stack (the first build can take a few minutes) …"
  fi

  set +e
  if [ -n "$one_shot_port" ] && [ -n "$one_shot_https" ]; then
    HERA_HTTP_PORT="$one_shot_port" HERA_HTTPS_PORT="$one_shot_https" "${COMPOSE[@]}" "${up_args[@]}"
  elif [ -n "$one_shot_port" ]; then
    HERA_HTTP_PORT="$one_shot_port" "${COMPOSE[@]}" "${up_args[@]}"
  elif [ -n "$one_shot_https" ]; then
    HERA_HTTPS_PORT="$one_shot_https" "${COMPOSE[@]}" "${up_args[@]}"
  else
    "${COMPOSE[@]}" "${up_args[@]}"
  fi
  local status=$?
  set -e
  if [ "$status" -ne 0 ]; then up_failed "$env"; exit 1; fi
  print_next_steps "$env"
}

cmd_down() { # ENV [--volumes] [--yes]
  local env="$1"; shift
  local volumes=0; ASSUME_YES=0
  while [ $# -gt 0 ]; do
