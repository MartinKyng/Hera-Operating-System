# Hera OS — environment template (Phase 0)
#
# The fast path does not edit this file at all (ADR-016):
#
#   ./deploy/install.sh --up   # generates every secret, writes deploy/.env once,
#                              # starts the stack → open http://localhost:8080
#                              # and the /setup wizard collects the rest.
#
# Copying by hand is still supported:
#   cp .env.example deploy/.env    # then fill in real values
#   (openssl rand -hex 32 for the key)
#
# `.env` is git-ignored; NEVER commit real secrets. Every value below is a
# named placeholder, not a credential.
#
# What belongs here: INFRASTRUCTURE (ports, hosts, database passwords, the
# JWT secret, image digests). What does NOT: the administrator account,
# company name, currency, time zone and provider keys — those are business
# values collected by the first-boot wizard at /setup and stored in the
# database (docs/onboarding.md). A running process never rewrites this file.
#
# Containers only (ADR-005): these variables are consumed by the Compose stack.
# There is no host-install mode.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
HERA_ENV=dev                                  # dev | prod
HERA_DOMAIN=localhost
HERA_SECRET_KEY=change-me-64-random-hex-bytes # signs JWTs (15-min access / 7-day rotating refresh)
# During key rotation only: set this to the previous real HERA_SECRET_KEY, wait
# longer than access_token_minutes, then blank it again.
HERA_SECRET_KEY_PREVIOUS=
HERA_DEFAULT_CURRENCY=NGN
HERA_DEFAULT_TIMEZONE=Africa/Lagos

# Site bootstrap — OPTIONAL. The /setup wizard (first visit to the desk)
# creates the Administrator and the company in the browser; these two values
# only matter for the scripted path (`hera-bench setup-site`, used by CI).
# Never commit real values.
HERA_ADMIN_EMAIL=admin@local.test
HERA_ADMIN_PASSWORD=change-me-strong-password # used only by hera-bench setup-site

# Host port where the Caddy proxy publishes the desk (http://localhost:8080)
HERA_HTTP_PORT=8080

# CORS/Host allowlists (CORS '*' is refused at boot; prod must name your domain).
# Dev keeps host/CORS values unset so preview/proxy hostnames still work.
# HERA_CORS_ORIGINS=http://localhost:8080,http://localhost
# HERA_TRUSTED_HOSTS=books.example.com,127.0.0.1,hera-api

# Require TOTP for the Administrator before the desk is usable (prod compose forces 1)
# HERA_REQUIRE_MFA=0

# ---------------------------------------------------------------------------
# Production images / HTTPS (Phase 9) + versioning (ADR-016)
# ---------------------------------------------------------------------------
# One version line for everything. A bump edits VERSION at the repo root and
# services/api/pyproject.toml, then runs `uv lock` in services/api. pyproject.toml reads it through hatch, app.__version__ comes
# from the installed package metadata, the web image injects it at build, and
# deploy/install.sh writes it here — so no other file carries a version
# literal (tests/test_versioning.py enforces that). Bump VERSION in the commit
# that ships the next version; leave this line empty and let install.sh fill
# it. A local `docker compose build` without it labels images "dev".
HERA_VERSION=
#
# Prod compose pulls immutable image@sha256 references. Fill each digest with
# the hex value from your registry (for first-party images) or from
# `docker buildx imagetools inspect IMAGE:TAG` (for Postgres/Redis/Caddy).
HERA_API_IMAGE=ghcr.io/martinkyng/hera-os-api
HERA_API_DIGEST=
HERA_WEB_IMAGE=ghcr.io/martinkyng/hera-os-web
HERA_WEB_DIGEST=
HERA_POSTGRES_DIGEST=
HERA_REDIS_DIGEST=
HERA_CADDY_DIGEST=
ACME_EMAIL=ops@example.com
# Production host allowlists. Set these when HERA_DOMAIN is not localhost.
# HERA_CORS_ORIGINS=https://books.example.com
# HERA_TRUSTED_HOSTS=books.example.com,127.0.0.1,hera-api

# ---------------------------------------------------------------------------
# Postgres (hera-db) — three roles with least privilege
# ---------------------------------------------------------------------------
POSTGRES_HOST=hera-db
POSTGRES_PORT=5432
POSTGRES_DB=hera
POSTGRES_USER=hera_admin                      # bootstrap superuser that creates the roles below
POSTGRES_PASSWORD=change-me
# NOTE: these passwords are written into the database ONCE, on the first boot
# of the hera-db-data volume (postgres/init-roles.sh). Changing them here later
# has no effect on an existing volume — either `docker compose down -v` (fresh
# site) or ALTER ROLE by hand.
HERA_DB_APP_PASSWORD=change-me                # hera_app     — runtime DML; INSERT+SELECT only on gl_entry
HERA_DB_MIGRATE_PASSWORD=change-me            # hera_migrate — Alembic migrations
HERA_DB_BACKUP_PASSWORD=change-me             # hera_backup  — pg_dump / restore only

# ---------------------------------------------------------------------------
# Redis (hera-redis) — Celery broker + cache/denylist
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me                      # hera-redis requirepass; keep REDIS_URL in sync
REDIS_URL=redis://:change-me@hera-redis:6379/0

# ---------------------------------------------------------------------------
# Payments — provider keys are stored per company in the database (encrypted
# at rest) via Payment settings in the desk, or seeded with:
#   hera-bench configure-payments     # reads the PAYSTACK_* / FLUTTERWAVE_* here
# These env values are NEVER logged and NEVER returned by the API.
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=change-me             # Paystack signs webhooks with the secret key; keep for reference

# ---------------------------------------------------------------------------
# Payments — Flutterwave
# ---------------------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-test-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-test-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=change-me            # the verif-hash you set in the Flutterwave dashboard

# Absolute public URL of the desk (provider checkouts redirect back here).
#HERA_PUBLIC_BASE_URL=https://books.example.com

# 1 = adapters answer without the provider network (e2e / demo only).
# Refused at boot when HERA_ENV=prod. Never set this on real money.
#HERA_PAYMENTS_STUB=0
#HERA_MESSAGING_STUB=0

# ---------------------------------------------------------------------------
# Production backups (Phase 9)
# ---------------------------------------------------------------------------
HERA_BACKUP_RETENTION_DAYS=14
HERA_BACKUP_INTERVAL_SECONDS=86400
# Optional S3-compatible offsite copy. Leave blank to keep backups on the volume only.
HERA_BACKUP_S3_URI=
HERA_BACKUP_S3_ENDPOINT_URL=
HERA_BACKUP_S3_REGION=us-east-1
HERA_BACKUP_S3_ACCESS_KEY_ID=
HERA_BACKUP_S3_SECRET_ACCESS_KEY=
# Files — attachments on a volume (Phase 8C)
# ---------------------------------------------------------------------------
# Per-attachment cap, enforced while the body streams (HERA_FILES_DIR is set by
# Compose to the hera-files volume, so it is normally not overridden here).
# Raising this alone does not help if a reverse proxy caps request bodies too.
HERA_ATTACHMENT_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Messaging — email (dev uses the console backend; SMTP is prod-only)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hera <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Messaging — WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=change-me               # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_APP_SECRET=change-me                 # validates X-Hub-Signature-256 on inbound webhooks
WHATSAPP_VERIFY_TOKEN=change-me               # webhook subscription challenge
